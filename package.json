{
  "name": "selfriser",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && rm -rf dist && vite build && cp cloudflare/_headers dist/_headers",
    "preview": "vite preview --host",
    "test": "vitest run",
    "deploy": "npm run build && npx wrangler deploy",
    "typecheck": "tsc --noEmit",
    "fake-hub": "node hardware/fake-hub.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "pdfjs-dist": "^6.4.299",
    "react": "~19.2",
    "react-dom": "~19.2",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  }
}
